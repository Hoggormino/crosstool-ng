# Optional GCC 8 worker profile. Vendor-facing modules retain armv6-samygo.cmake.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(SAMSUNG_MODERN_PREFIX "$ENV{SAMSUNG_MODERN_PREFIX}" CACHE PATH "Isolated modern worker compiler prefix")
if(NOT SAMSUNG_MODERN_PREFIX)
    message(FATAL_ERROR "Set SAMSUNG_MODERN_PREFIX to the completed isolated install prefix")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES SAMSUNG_MODERN_PREFIX)
set(_samsung_triplet arm-samsung-linux-gnueabi)
set(CMAKE_C_COMPILER "${SAMSUNG_MODERN_PREFIX}/bin/${_samsung_triplet}-gcc")
set(CMAKE_CXX_COMPILER "${SAMSUNG_MODERN_PREFIX}/bin/${_samsung_triplet}-g++")
set(CMAKE_AR "${SAMSUNG_MODERN_PREFIX}/bin/${_samsung_triplet}-ar")
set(CMAKE_RANLIB "${SAMSUNG_MODERN_PREFIX}/bin/${_samsung_triplet}-ranlib")
set(CMAKE_SYSROOT "${SAMSUNG_MODERN_PREFIX}/${_samsung_triplet}/sysroot")
if(NOT EXISTS "${CMAKE_CXX_COMPILER}")
    message(FATAL_ERROR "Modern worker toolchain has not been built at ${SAMSUNG_MODERN_PREFIX}")
endif()
set(CMAKE_C_FLAGS_INIT "-march=armv6j -mtune=arm1136jf-s -marm -mfpu=vfp -mfloat-abi=softfp -mno-unaligned-access -gdwarf-2")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -fno-gnu-unique")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,--hash-style=sysv")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-Wl,--hash-style=sysv")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
# Do executable link checks; a static try-compile would hide old-linker failures.

# Keep pkg-config discovery within the target sysroot as well.
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
