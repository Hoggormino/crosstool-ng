CT_CONFIG_VERSION="4"
CT_OBSOLETE=y
CT_EXPERIMENTAL=y
CT_DEBUG_CT=y
CT_DEBUG_CT_SAVE_STEPS=y
CT_DEBUG_CT_SAVE_STEPS_COMPRESS_NONE=y
CT_LOCAL_TARBALLS_DIR="${CT_TOP_DIR}/archives"
CT_PREFIX_DIR="${CT_TOP_DIR}/install"
CT_PARALLEL_JOBS=4
CT_EXTRA_CFLAGS_FOR_BUILD="-fcommon"
CT_EXTRA_CFLAGS_FOR_HOST="-fcommon"
# CT_LOG_PROGRESS_BAR is not set
# CT_LOG_FILE_COMPRESS is not set
CT_ARCH_ARM=y
CT_ARCH_TUNE="arm1136jf-s"
CT_ARCH_ARCH="armv6j"
CT_ARCH_FPU="vfp"
CT_ARCH_FLOAT_SOFTFP=y
CT_TARGET_CFLAGS="-gdwarf-2 -mno-unaligned-access"
# CT_SHOW_CT_VERSION is not set
CT_TOOLCHAIN_PKGVERSION="Samsung-B-series-HEAD-a4895d7f-GCC-16.2.0-runtime-math"
CT_TARGET_VENDOR="samsung"
CT_KERNEL_LINUX=y
CT_LINUX_SRC_CUSTOM=y
CT_LINUX_CUSTOM_LOCATION="${CT_TOP_DIR}/prepared/linux"
CT_LINUX_V_2_6=y
CT_BINUTILS_SRC_CUSTOM=y
CT_BINUTILS_CUSTOM_LOCATION="${CT_TOP_DIR}/prepared/binutils"
CT_BINUTILS_V_2_17=y
CT_BINUTILS_EXTRA_CONFIG_ARRAY="--disable-werror --disable-nls"
CT_GLIBC_SRC_CUSTOM=y
CT_GLIBC_CUSTOM_LOCATION="${CT_TOP_DIR}/prepared/glibc"
CT_GLIBC_V_2_5_90=y
CT_GLIBC_USE_LIBIDN_ADDON=y
CT_GLIBC_EXTRA_CONFIG_ARRAY="--without-fp --enable-clocale=gnu --without-selinux --disable-nls --disable-ipv6"
CT_GLIBC_CONFIGPARMS="slibdir=/lib"
CT_GLIBC_EXTRA_CFLAGS="-fgnu89-inline -fcommon -fno-stack-protector"
CT_GLIBC_KERNEL_VERSION_CHOSEN=y
CT_GLIBC_MIN_KERNEL_VERSION="2.6.16"
CT_CC_GCC_ENABLE_CXX_FLAGS="-fno-gnu-unique -mno-unaligned-access"
CT_CC_GCC_CORE_EXTRA_CONFIG_ARRAY="--with-specs=%{!munaligned-access:%{!mno-unaligned-access:-mno-unaligned-access}} --disable-nls --disable-lto"
CT_CC_GCC_EXTRA_CONFIG_ARRAY="--with-specs=%{!munaligned-access:%{!mno-unaligned-access:-mno-unaligned-access}} --enable-libstdcxx-samsung-math --disable-gnu-unique-object --disable-libsanitizer --disable-libgomp --disable-libssp --disable-libquadmath --disable-libvtv --disable-libcilkrts --disable-libmpx --disable-libitm --disable-lto --disable-nls"
# CT_CC_GCC_USE_LTO is not set
CT_CC_GCC_LNK_HASH_STYLE_SYSV=y
CT_CC_LANG_CXX=y

CT_GCC_V_16=y
