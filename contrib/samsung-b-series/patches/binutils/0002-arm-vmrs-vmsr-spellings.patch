# Support modern spellings using the existing VFP status-transfer encoders.
# No new instruction encodings or ISA levels are introduced.
--- a/gas/config/tc-arm.c
+++ b/gas/config/tc-arm.c
@@ -7127,6 +7127,22 @@
     return FAIL;
 
   return SUCCESS;
+}
+
+/* Unified VMRS/VMSR are spellings of the existing VFP status transfers.
+   Keep their operands restricted to VFP system registers.  */
+static void
+do_vfp_vmrs (void)
+{
+  if (do_vfp_nsyn_mrs () == FAIL)
+    first_error (_("VFP system register expected"));
+}
+
+static void
+do_vfp_vmsr (void)
+{
+  if (do_vfp_nsyn_msr () == FAIL)
+    first_error (_("VFP system register expected"));
 }
 
