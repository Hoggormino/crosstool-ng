--- /dev/null
+++ b/libstdc++-v3/src/c++11/samsung_math.cc
@@ -0,0 +1,288 @@
+// Private runtime corrections for the Samsung ARMv6/glibc 2.5 TV UI process.
+// FMA algorithms adapted from musl src/math/fma.c and fmaf.c at
+// 7813e9119eb5fe681b6750b8a033a0490bca0941 (official musl Git).
+// The 64-bit conversion is adapted for ARM's fixed-rounding __aeabi_l2d.
+// Other functions are small target-specific compositions / bit operations.
+/*
