+static inline double samsung_from_bits(uint64_t u) { double x; memcpy(&x,&u,8); return x; }
+#define EXTRACT_WORDS(h,l,x) do { uint64_t u_=samsung_bits(x); (h)=u_>>32; (l)=(uint32_t)u_; } while(0)
+#define GET_HIGH_WORD(h,x) do { (h)=samsung_bits(x)>>32; } while(0)
+#define SET_HIGH_WORD(x,h) do { (x)=samsung_from_bits((samsung_bits(x)&UINT64_C(0xffffffff))|((uint64_t)(uint32_t)(h)<<32)); } while(0)
+#define GET_FLOAT_WORD(u,x) do { float f_=(x); memcpy(&(u),&f_,4); } while(0)
+#define SET_FLOAT_WORD(x,u) do { uint32_t u_=(u); memcpy(&(x),&u_,4); } while(0)
+/* FreeBSD math_private.h: preserve its NaN mixing expression. */
+#define nan_mix(x,y) (((x)+0.0L)+((y)+0))
